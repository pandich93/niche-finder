# Скопируйте в .env:  cp .env.example .env
# Ключ: https://console.cloud.google.com/apis/credentials
# (в том же проекте включите "YouTube Data API v3")
YOUTUBE_API_KEY=

# --- Postgres ---------------------------------------------------------------
# Без Docker: поднимите Postgres сами (или `docker compose up -d postgres` из
# корня проекта, который публикует его на 127.0.0.1:5433 по умолчанию) и
# укажите host/port ниже. Внутри docker-compose эти переменные подставляются
# автоматически (POSTGRES_HOST=postgres) -- трогать не нужно.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=niches
POSTGRES_USER=niches
POSTGRES_PASSWORD=niches
# Или одной строкой вместо пяти переменных выше:
# NICHE_DATABASE_URL=postgresql://niches:niches@localhost:5433/niches
# Отдельная Postgres-схема вместо "public" -- удобно для тестов/нескольких
# копий на одной базе:
# NICHE_DB_SCHEMA=public

# --- фоновый воркер (python3 worker.py) ----------------------------------
# Перечитывать счётчики свежих видео — из этого берутся vph24h,
# viewsGained24h, acceleration и детект смены заголовка/обложки.
WORKER_HOT_INTERVAL_MIN=180
WORKER_HOT_PERIOD=7d
WORKER_HOT_LIMIT=1000

# Раз в сутки: широкий рефреш + снапшоты каналов + чарты.
WORKER_DAILY_INTERVAL_MIN=1440
WORKER_FULL_PERIOD=30d
WORKER_FULL_LIMIT=3000
WORKER_REGIONS=US
WORKER_TRENDING=1

# Темы, которые держим свежими. Один поисковый вызов на тему в сутки
# из бюджета в 100 — до ~90 тем безопасно.
# WORKER_QUERIES=ai automation,faceless history,нейросети для бизнеса
WORKER_QUERY_PERIOD=24h
WORKER_QUERY_PAGES=1

# --- транспорт MCP -------------------------------------------------------
# stdio (по умолчанию) или streamable-http
# MCP_TRANSPORT=stdio
# MCP_PORT=8765

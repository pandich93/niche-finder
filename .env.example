# Copy to .env (next to docker-compose.yml) and fill in.
# Get a key: https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3" in the same project.
YOUTUBE_API_KEY=

TZ=Asia/Tashkent

# --- Postgres --------------------------------------------------------------
# POSTGRES_HOST=postgres is the docker-compose service name; it resolves for
# any container on the `niche-finder_default` network (compose services, and
# scripts/mcp-docker.sh which joins that network explicitly). Running the
# server outside Docker instead? Set POSTGRES_HOST=localhost and use
# POSTGRES_HOST_PORT below (the port Postgres is published on, 127.0.0.1 only).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=niches
POSTGRES_USER=niches
POSTGRES_PASSWORD=niches
POSTGRES_HOST_PORT=5433

# --- background worker ---------------------------------------------------
# Free novelty check for tracked channels via YouTube's RSS feed (no key,
# no quota) -- catches new uploads between the more expensive hot/daily
# refreshes below. Misses anything past the feed's ~15 most recent uploads.
WORKER_RSS_INTERVAL_MIN=30
# Alerts (8.9): compares fresh snapshots for TRACKED channels against
# thresholds and writes events (new outlier, acceleration, title change,
# came back after a silent stretch). Zero quota -- reads only what's already
# in the database, so this can safely run more often than the API-calling
# jobs below.
WORKER_ALERTS_INTERVAL_MIN=60
# Re-read view counts for videos published in the last WORKER_HOT_PERIOD.
# This is what makes vph24h / viewsGained24h / acceleration work at all.
WORKER_HOT_INTERVAL_MIN=180
WORKER_HOT_PERIOD=7d
WORKER_HOT_LIMIT=1000

# Once a day: wider refresh + channel snapshots + trending charts.
WORKER_DAILY_INTERVAL_MIN=1440
WORKER_FULL_PERIOD=30d
WORKER_FULL_LIMIT=3000
WORKER_REGIONS=US
WORKER_TRENDING=1

# Topics to keep continuously fresh. One search call each per day out of the
# 100/day search budget, so up to ~90 topics is safe.
# WORKER_QUERIES=ai automation,faceless history,нейросети для бизнеса
WORKER_QUERY_PERIOD=24h
WORKER_QUERY_PAGES=1

# Bake the 220MB embedding model into the image at build time (0 = download on
# first use into the /models volume instead).
PREFETCH_MODEL=0

# Порт дашборда (http://localhost:<WEB_PORT>), слушает только localhost.
WEB_PORT=8080

# Port for the optional HTTP transport profile.
MCP_PORT=8765
